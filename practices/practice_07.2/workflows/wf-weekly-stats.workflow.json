    {
      "parameters": {
        "jsCode": "// HTML-письмо: сводка, Δ к прошлой неделе, таблицы по типу и по автору, AI-комментарий недели.\nconst d = $('Compute Δ vs previous week').first().json;\nconst ai = ($json.text || '').replace(/<think>[\\s\\S]*?<\\/think>/g, '').trim();\nconst esc = s => String(s).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\nconst fmt = v => v === null || v === undefined ? '—' : v > 0 ? `<span style=\"color:#1a7f37\">+${v}</span>` : v < 0 ? `<span style=\"color:#cf222e\">${v}</span>` : '0';\nconst td = 'style=\"border:1px solid #d0d7de;padding:6px 10px\"';\nconst th = 'style=\"border:1px solid #d0d7de;padding:6px 10px;background:#f6f8fa;text-align:left\"';\nconst label = { issues_opened: 'Issues открыто', issues_closed: 'Issues закрыто', prs_opened: 'PR открыто', prs_merged: 'PR смёржено', bug: 'bug', task: 'task', feature: 'feature', needs_triage: 'needs-triage' };\nconst prevW = d.previous ? d.previous.week_start : null;\nconst summary = Object.keys(label).map(k => `<tr><td ${td}>${label[k]}</td><td ${td}>${d.current[k]}</td><td ${td}>${d.previous ? d.previous[k] : '—'}</td><td ${td}>${fmt(d.delta[k])}</td></tr>`).join('');\nconst authors = d.by_author.length ? d.by_author.map(a => `<tr><td ${td}>@${esc(a.author)}</td><td ${td}>${a.total}</td><td ${td}>${a.bug}</td><td ${td}>${a.task}</td><td ${td}>${a.feature}</td><td ${td}>${a['needs-triage']}</td><td ${td}>${a.unlabeled}</td></tr>`).join('') : `<tr><td ${td} colspan=\"7\">Нет новых Issues</td></tr>`;\nconst html = `<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#1f2328\">\n<h2>📊 Еженедельная статистика Issues — ${esc(d.repo)}</h2>\n<p>Период: <b>${d.week_start}</b> — <b>${d.week_end}</b>${prevW ? ` · сравнение с неделей от ${prevW}` : ' · прошлой недели в Data Table нет'}</p>\n<h3>Сводка и Δ к прошлой неделе</h3>\n<table style=\"border-collapse:collapse\"><tr><th ${th}>Метрика</th><th ${th}>Эта неделя</th><th ${th}>Прошлая</th><th ${th}>Δ</th></tr>${summary}</table>\n<h3>По автору (открытые за неделю Issues)</h3>\n<table style=\"border-collapse:collapse\"><tr><th ${th}>Автор</th><th ${th}>Всего</th><th ${th}>bug</th><th ${th}>task</th><th ${th}>feature</th><th ${th}>needs-triage</th><th ${th}>без лейбла</th></tr>${authors}</table>\n<h3>🤖 AI-комментарий недели</h3>\n<div style=\"background:#f6f8fa;border-left:4px solid #8250df;padding:10px 14px\">${esc(ai).replace(/\\n/g, '<br>')}</div>\n<p style=\"color:#656d76;font-size:12px\">Сгенерировано n8n · execution ${$execution.id}</p></div>`;\nreturn [{ json: { subject: `[${d.repo}] Issues за неделю ${d.week_start} — ${d.week_end}: +${d.current.issues_opened} / закрыто ${d.current.issues_closed}`, html, report_to: $('Config').first().json.report_to } }];"
      },
      "id": "2e89d107-4688-5ae1-a417-ea51955dc446",
