    {
      "parameters": {
        "jsCode": "// Группировка статистики за неделю: по типу (лейблы WF1) и по автору.\nconst cfg = $('Config').first().json;\nconst opened = $('GH: issues opened this week').first().json.items || [];\nconst closed = $('GH: issues closed this week').first().json.items || [];\nconst prsOpened = $('GH: PRs opened this week').first().json.items || [];\nconst prsMerged = $('GH: PRs merged this week').first().json.items || [];\nconst TYPES = ['bug', 'task', 'feature', 'needs-triage'];\nconst typeOf = i => {\n  const names = (i.labels || []).map(l => typeof l === 'string' ? l : l.name);\n  return TYPES.find(t => names.includes(t)) || 'unlabeled';\n};\nconst byType = Object.fromEntries([...TYPES, 'unlabeled'].map(t => [t, 0]));\nconst byAuthor = {};\nfor (const i of opened) {\n  const t = typeOf(i), a = i.user?.login || 'unknown';\n  byType[t]++;\n  byAuthor[a] ||= { author: a, total: 0, bug: 0, task: 0, feature: 0, 'needs-triage': 0, unlabeled: 0 };\n  byAuthor[a].total++; byAuthor[a][t]++;\n}\nconst closedByType = Object.fromEntries([...TYPES, 'unlabeled'].map(t => [t, 0]));\nfor (const i of closed) closedByType[typeOf(i)]++;\nconst stats = {\n  week_start: cfg.since, week_end: cfg.until, repo: `${cfg.owner}/${cfg.repo}`,\n  issues_opened: opened.length, issues_closed: closed.length,\n  prs_opened: prsOpened.length, prs_merged: prsMerged.length,\n  by_type: byType, closed_by_type: closedByType,\n  by_author: Object.values(byAuthor).sort((a, b) => b.total - a.total),\n};\nreturn [{ json: stats }];"
      },
