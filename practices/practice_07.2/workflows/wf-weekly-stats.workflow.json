    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты — аналитик поддержки open-source проекта. По статистике GitHub Issues за неделю и изменениям к прошлой неделе напиши «AI-комментарий недели»: 3–5 предложений на русском, без markdown-заголовков.\nОтметь главные изменения (рост/падение багов, баланс открытых и закрытых, сколько ушло в needs-triage), самых активных авторов и дай 1–2 конкретные рекомендации команде.\nЕсли данных прошлой недели нет — так и скажи и оцени только текущую неделю.\n\nТекущая неделя ({{ $json.payload.week_start }} — {{ $json.payload.week_end }}):\n{{ JSON.stringify($json.payload.current) }}\nПо авторам: {{ JSON.stringify($json.payload.by_author) }}\n\nПрошлая неделя: {{ $json.payload.previous ? JSON.stringify({ week_start: $json.payload.previous.week_start, issues_opened: $json.payload.previous.issues_opened, issues_closed: $json.payload.previous.issues_closed, prs_opened: $json.payload.previous.prs_opened, prs_merged: $json.payload.previous.prs_merged, bug: $json.payload.previous.bug, task: $json.payload.previous.task, feature: $json.payload.previous.feature, needs_triage: $json.payload.previous.needs_triage }) : 'нет данных' }}\nΔ (эта − прошлая): {{ JSON.stringify($json.payload.delta) }}",
        "hasOutputParser": false
      },
      "id": "039680b2-5fcc-529f-a322-004b140be766",
      "name": "AI comment of the week (Basic LLM Chain)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
