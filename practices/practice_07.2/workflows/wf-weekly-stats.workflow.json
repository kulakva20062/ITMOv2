    {
      "parameters": {
        "jsCode": "// Δ к прошлой неделе: берём из Data Table самую свежую запись с week_start раньше текущей.\nconst s = $('Group by type & author').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.week_start && r.week_start < s.week_start);\nrows.sort((a, b) => a.week_start < b.week_start ? 1 : -1);\nconst prev = rows[0] || null;\nconst metrics = ['issues_opened', 'issues_closed', 'prs_opened', 'prs_merged', 'bug', 'task', 'feature', 'needs_triage'];\nconst cur = { issues_opened: s.issues_opened, issues_closed: s.issues_closed, prs_opened: s.prs_opened,\n  prs_merged: s.prs_merged, bug: s.by_type.bug, task: s.by_type.task, feature: s.by_type.feature,\n  needs_triage: s.by_type['needs-triage'] };\nconst delta = {};\nfor (const m of metrics) delta[m] = prev ? cur[m] - Number(prev[m] || 0) : null;\nreturn [{ json: { ...s, current: cur, previous: prev, delta } }];"
      },
