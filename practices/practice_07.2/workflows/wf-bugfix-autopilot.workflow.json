        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"path\": {\n      \"type\": \"string\"\n    },\n    \"new_content\": {\n      \"type\": \"string\"\n    },\n    \"commit_message\": {\n      \"type\": \"string\"\n    },\n    \"explanation\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"path\",\n    \"new_content\",\n    \"commit_message\",\n    \"explanation\"\n  ]\n}"
      },
      "id": "2cdd506e-7282-5940-b48d-7edf9a89c31d",
      "name": "Fix output parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2120,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Проверяем ответ фиксера и готовим коммит (base64 для Contents API).\nconst ctx = $('Prepare fix prompt').first().json;\nconst o = $json.output ?? $json;\nconst f = ctx.files.find(x => x.path === o.path);\nif (!f) throw new Error(`Фиксер вернул файл ${o.path}, которого нет среди кандидатов`);\nlet content = String(o.new_content || '');\nif (!content.endsWith('\\n')) content += '\\n';\nif (content.trim() === f.content.trim()) throw new Error('Фиксер не изменил файл');\nconst stamp = $now.toFormat('yyyyLLdd-HHmmss');\nreturn [{ json: { ...ctx, files: undefined, path: f.path, file_sha: f.sha, content_b64: Buffer.from(content, 'utf8').toString('base64'),\n  commit_message: `${o.commit_message || 'Fix bug'} (fixes #${ctx.issue_number})`, explanation: o.explanation || '',\n  branch: `ai-fix/issue-${ctx.issue_number}-${stamp}` } }];"
      },
