    {
      "parameters": {
        "jsCode": "// Кандидаты для исправления: исходники проекта (без тестов/доков), не больше 12 файлов.\nconst tree = $json.tree || [];\nconst ok = /\\.(py|js|ts|go|java|cs|rb)$/;\nconst files = tree.filter(f => f.type === 'blob' && ok.test(f.path) && !/(^|\\/)(tests?|docs?)\\//.test(f.path) && (f.size || 0) < 30000).slice(0, 12);\nreturn files.map(f => ({ json: { path: f.path } }));"
      },
      "id": "a2c7e7e1-9e19-5d08-b424-655e499079a5",
      "name": "Pick source files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        40
      ]
    },
