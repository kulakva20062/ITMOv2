    {
      "parameters": {
        "jsCode": "// Готовим промпт фиксеру: текст bug report + исходники с номерами строк.\nconst ctx = $('Bug context').first().json;\nconst files = $input.all().map(i => ({ path: i.json.path, content: Buffer.from(i.json.content || '', 'base64').toString('utf8'), sha: i.json.sha }));\nconst src = files.map(f => `=== FILE: ${f.path} ===\\n` + f.content.split('\\n').map((l, n) => `${String(n + 1).padStart(4)}| ${l}`).join('\\n')).join('\\n\\n');\nconst prompt = `Ты — разработчик, который исправляет баг по bug report из GitHub Issue.\nIssue #${ctx.issue_number}: ${ctx.title}\n${ctx.body}\n\nИсходники репозитория (номера строк только для навигации, в ответ их не включай):\n${src}\n\nНайди причину бага и исправь её МИНИМАЛЬНЫМ изменением в ОДНОМ файле. Не меняй тесты и стиль кода без необходимости.\nВерни путь файла, ПОЛНОЕ новое содержимое этого файла, сообщение коммита и короткое объяснение на русском.`;\nreturn [{ json: { ...ctx, files, prompt } }];"
      },
