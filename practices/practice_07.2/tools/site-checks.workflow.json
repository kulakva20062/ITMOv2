    {
      "id": "955b64a6-5ab5-4b0e-9b23-f50852ac0115",
      "name": "Check and report the result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        260
      ],
      "parameters": {
        "jsCode": "\nconst { practice } = $('Run practice checks').first().json.body;\nconst outputs = $('Read GitHub evidence').all().map(item => item.json.body);\nconst checks = [];\nfunction check(name, result) { checks.push({name, ok: Boolean(result)}); }\nif (practice === '7.1') {\n  const [reviews, inline, comments] = outputs;\n  check('В PR есть два ревью', reviews.length >= 2);\n  check('Inline-комментарии охватывают оба блока PR', Array.isArray(inline) && inline.length >= 4 && new Set(inline.map(comment => comment.line)).size >= 2);\n  check('GitHub получил сообщение о пропуске повтора', comments.some(comment => comment.body.includes('пропущен')));\n  const rows = $input.all().map(item => item.json).filter(row => row.pr_key === 'kulakva20062/practice-7-n8n-demo#1');\n  check('Таблица учебного n8n содержит два разных AI-ревью PR №1', new Set(rows.map(row => row.model)).size >= 2);\n} else {\n  const [bug, feature, task, unknown, pulls] = outputs;\n  for (const [issue, label] of [[bug, 'bug'], [feature, 'feature'], [task, 'task'], [unknown, 'needs-triage']]) {\n    check(`Issue №${issue.number} получила метку ${label}`, issue.labels.some(item => item.name === label) && (label !== 'needs-triage' || issue.comments === 0));\n  }\n  const stats = $('Read historical metrics').all().map(item => item.json);\n  check('В учебном n8n записана статистика двух недель', new Set(stats.filter(row => row.repo === 'kulakva20062/practice-7-n8n-demo').map(row => row.week_start)).size >= 2);\n  const fixes = $input.all().map(item => item.json);\n  const fixed = pulls.find(pr => pr.merged_at && pr.head.ref.startsWith('ai-fix/issue-2-') && /Fixes #2\\b/i.test(pr.body || ''));\n  check('Issue №2 закрыта после автоматического merge', bug.state === 'closed' && fixed && fixes.some(row => row.merged === true && row.pr_number === fixed.number));\n}\nreturn [{json: {practice, checks, ok: checks.every(check => check.ok), workflowId: $workflow.id, executionId: $execution.id}}];\n"
      }
    }
  ],
