      ],
      "parameters": {
        "jsCode": "\nconst { practice } = $json.body;\nconst api = 'https://api.github.com/repos/kulakva20062/practice-7-n8n-demo';\nconst endpoints = {\n  '7.1': ['pulls/1/reviews', 'pulls/1/comments', 'issues/1/comments'],\n  '7.2': ['issues/2', 'issues/3', 'issues/4', 'issues/5', 'pulls?state=closed&base=main&per_page=50'],\n};\nif (!Object.hasOwn(endpoints, practice)) throw new Error('Unknown practice');\nreturn endpoints[practice].map(path => ({json: {path, url: `${api}/${path}`}}));\n"
      }
    },
