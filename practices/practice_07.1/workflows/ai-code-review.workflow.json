      "id": "1387ce6b-5f12-575c-8303-96ecc01088b3",
      "name": "Get PR files (patches)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        60
      ],
      "credentials": {
        "githubApi": {
