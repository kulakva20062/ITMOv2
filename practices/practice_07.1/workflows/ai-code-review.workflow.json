      "parameters": {
        "jsCode": "// Единый контекст для всех веток: какой PR, какая модель, откуда пришёл запуск.\nconst ev = $('GitHub Trigger').first().json;\nconst b = ev.body;\nconst route = $json;\nconst repo = b.repository;\nconst number = b.pull_request ? b.number : b.issue.number;\nreturn [{ json: {\n  api: repo.url,                       // https://api.github.com/repos/<owner>/<repo>\n  repo: repo.full_name,\n  pr_number: number,\n  pr_key: `${repo.full_name}#${number}`,\n  mode: route.mode,                    // primary | other\n  model: route.mode === 'other' ? route.model_other : route.model_primary,\n  trigger: route.trigger,              // pr_opened | comment\n  command: route.command || '',\n  requested_by: b.sender?.login || '',\n} }];"
      },
