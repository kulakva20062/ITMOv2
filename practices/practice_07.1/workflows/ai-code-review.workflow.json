    {
      "parameters": {
        "jsCode": "// Собираем один GitHub review: общий вывод + точечный комментарий к каждому блоку diff.\nconst src = $('Split diff into hunks').first().json;\nconst raw = $json.text ?? $json.output ?? '';\nlet parsed = { summary: '', comments: [] };\ntry {\n  const s = String(raw).replace(/<think>[\\s\\S]*?<\\/think>/g, '').replace(/```(?:json)?/g, '');\n  parsed = JSON.parse(s.slice(s.indexOf('{'), s.lastIndexOf('}') + 1));\n} catch (e) {\n  parsed = { summary: String(raw).slice(0, 4000), comments: [] };\n}\nconst icon = { bug: '🐞', security: '🔐', performance: '🐢', style: '🎨', ok: '✅' };\nconst byHunk = {};\nfor (const c of parsed.comments || []) {\n  const k = String(c.hunk || '').trim().toUpperCase();\n  if (k) (byHunk[k] ||= []).push(c);\n}\nconst comments = src.hunks.map(h => {\n  const cs = byHunk[h.id] || [{ severity: 'ok', comment: 'Замечаний к этому блоку нет.' }];\n  const body = cs.map(c => `${icon[c.severity] || '💬'} **${c.severity || 'note'}** — ${c.comment}`).join('\\n\\n');\n  const c = { path: h.path, line: h.anchor.line, side: h.anchor.side, body: `**${h.id}** · ${body}` };\n  if (h.anchor.start_line < h.anchor.line) { c.start_line = h.anchor.start_line; c.start_side = h.anchor.side; }\n  return c;\n});\nconst title = src.mode === 'other' ? 'Второе мнение' : 'AI review';\nconst body = `## 🤖 ${title} · \\`${src.model}\\`\\n\\n${parsed.summary || ''}\\n\\n` +\n  `<sub>Запуск: ${src.trigger === 'comment' ? 'команда ' + src.command : 'открытие PR'} · точечных комментариев: ${comments.length} · n8n execution ${$execution.id}</sub>`;\nreturn [{ json: { ...src, review: { commit_id: src.head_sha, event: 'COMMENT', body, comments },\n  fallback_body: body + '\\n\\n---\\n' + comments.map(c => `**${c.path}:${c.line}**\\n${c.body}`).join('\\n\\n') } }];"
      },
